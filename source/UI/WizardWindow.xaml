<Window x:Class="Ultragear.UI.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistente de Imagem Personalizada" Width="900" Height="700" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" ShowInTaskbar="True">
    <Border CornerRadius="22" Background="{StaticResource PanelBg}" BorderBrush="#4C5590" BorderThickness="1" Margin="10">
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
        <Grid Margin="30,22,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Drag" Background="Transparent">
                <StackPanel>
                    <TextBlock Text="Assistente de Imagem Personalizada" Style="{StaticResource PageTitle}" FontSize="22"/>
                    <TextBlock x:Name="StepText" Style="{StaticResource PageDesc}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" ToolTip="Sair sem salvar">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="14" Height="14"/>
                </Button>
            </Grid>
            <StackPanel x:Name="Dots" Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="14" ClipToBounds="True" Background="Black" Margin="0,0,20,0">
                    <Canvas x:Name="Reference" ClipToBounds="True"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Question" Style="{StaticResource Label}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Guide" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                    <StackPanel x:Name="Options"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="Status" Grid.Row="3" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="BackBtn" Content="Anterior" Style="{StaticResource PillButton}" Width="130" Margin="0,0,8,0" Click="Back_Click"/>
                <Button x:Name="NextBtn" Content="Começar" Style="{StaticResource AccentButton}" Width="150" Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
