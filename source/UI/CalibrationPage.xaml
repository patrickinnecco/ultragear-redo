<UserControl x:Class="Ultragear.UI.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
        <StackPanel Margin="40,10,24,20">
            <TextBlock Text="Calibração e cor" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Sensor de cor, modos de calibração, perfis ICC do Windows e padrões de teste." Style="{StaticResource PageDesc}" Margin="0,6,0,18"/>

            <!-- Sensor -->
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSensor}" Style="{StaticResource SectionIcon}"/>
                <TextBlock Text="Sensor (colorímetro)" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <TextBlock x:Name="SensorText" Style="{StaticResource Label}" Margin="2,10,0,0"/>
            <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0"
                       Text="A calibração por hardware (gravar o resultado nos modos Calibração 1/2), a validação ΔE, DICOM, 3D LUT, HDR e o agendamento exigem um colorímetro compatível e o protocolo proprietário de gravação de LUT do monitor. O Ultragear detecta o sensor, mas não executa essa calibração — use o LG Calibration Studio para isso e depois selecione aqui o modo Calibração 1 ou 2."/>
            <Button Content="Procurar sensor novamente" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Sensor_Click"/>

            <Border Style="{StaticResource Divider}"/>

            <!-- Calibration modes -->
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconCalibration}" Style="{StaticResource SectionIcon}"/>
                <TextBlock Text="Modos de calibração" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,10" Text="Ativa o resultado de calibração armazenado no monitor (somente em SDR)."/>
            <UniformGrid Columns="2">
                <Button Content="Usar Calibração 1" Style="{StaticResource PillButton}" Margin="0,0,5,0" Tag="18" Click="CalMode_Click"/>
                <Button Content="Usar Calibração 2" Style="{StaticResource PillButton}" Margin="5,0,0,0" Tag="19" Click="CalMode_Click"/>
            </UniformGrid>
            <TextBlock x:Name="CalModeText" Style="{StaticResource Hint}" Margin="2,8,0,0"/>

            <Border Style="{StaticResource Divider}"/>

            <!-- ICC -->
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconPicture}" Style="{StaticResource SectionIcon}"/>
                <TextBlock Text="Perfil de cor do Windows (ICC)" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <TextBlock x:Name="IccCurrent" Style="{StaticResource Label}" Margin="2,10,0,0"/>
            <ComboBox x:Name="IccCombo" Margin="0,10,0,0"/>
            <UniformGrid Columns="2" Margin="0,10,0,0">
                <Button Content="Definir como padrão" Style="{StaticResource AccentButton}" Margin="0,0,5,0" Click="IccSet_Click"/>
                <Button Content="Importar perfil…" Style="{StaticResource PillButton}" Margin="5,0,0,0" Click="IccImport_Click"/>
            </UniformGrid>
            <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0" Text="Associa o perfil apenas a este monitor, para o usuário atual. Útil para perfis gerados por ferramentas de calibração por software."/>

            <Border Style="{StaticResource Divider}"/>

            <!-- Patterns -->
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconPattern}" Style="{StaticResource SectionIcon}"/>
                <TextBlock Text="Padrões de teste" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,10" Text="Exibe padrões em tela cheia no monitor para conferir visualmente brilho, preto, gama e cores. Setas trocam o padrão; Esc fecha. Fecha sozinho após 3 min (proteção OLED)."/>
            <UniformGrid Columns="2">
                <Button Content="Rampa de cinza" Style="{StaticResource PillButton}" Margin="0,0,5,8" Tag="0" Click="Pattern_Click"/>
                <Button Content="Nível de preto" Style="{StaticResource PillButton}" Margin="5,0,0,8" Tag="1" Click="Pattern_Click"/>
                <Button Content="Saturação de branco" Style="{StaticResource PillButton}" Margin="0,0,5,8" Tag="2" Click="Pattern_Click"/>
                <Button Content="Gama (2.2)" Style="{StaticResource PillButton}" Margin="5,0,0,8" Tag="3" Click="Pattern_Click"/>
                <Button Content="Barras de cor" Style="{StaticResource PillButton}" Margin="0,0,5,8" Tag="4" Click="Pattern_Click"/>
                <Button Content="Cores sólidas" Style="{StaticResource PillButton}" Margin="5,0,0,8" Tag="5" Click="Pattern_Click"/>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
