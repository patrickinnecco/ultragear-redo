<UserControl x:Class="Ultragear.UI.SplitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
        <StackPanel Margin="40,10,24,20">
            <TextBlock Text="Divisão de tela" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Divida a área de trabalho do monitor em zonas e organize as janelas." Style="{StaticResource PageDesc}" Margin="0,6,0,18"/>

            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconKeyboard}" Style="{StaticResource SectionIcon}"/>
                <TextBlock Text="Atalhos" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <Grid Margin="0,12,0,0">
                <TextBlock Text="Atalhos de teclado" Style="{StaticResource Label}"/>
                <CheckBox x:Name="HotkeyToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Click="HotkeyToggle_Click"/>
            </Grid>
            <Grid Margin="0,10,0,0">
                <TextBlock Text="Organizar janelas nas zonas" Style="{StaticResource Hint}" FontSize="12.5"/>
                <TextBlock Text="Alt + Shift + L" Style="{StaticResource ValueText}" Foreground="{StaticResource Accent}"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <TextBlock Text="Mover a janela ativa entre zonas" Style="{StaticResource Hint}" FontSize="12.5"/>
                <TextBlock Text="Alt + Shift + Setas" Style="{StaticResource ValueText}" Foreground="{StaticResource Accent}"/>
            </Grid>
            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Foreground="{StaticResource Warning}" Margin="0,6,0,0"/>
            <Grid Margin="0,14,0,0">
                <TextBlock Text="Encaixar ao arrastar uma janela" Style="{StaticResource Label}" Margin="0,0,70,0"/>
                <CheckBox x:Name="SnapToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Click="SnapToggle_Click"/>
            </Grid>
            <TextBlock Text="Ao arrastar uma janela pela barra de título, as zonas aparecem no monitor; solte sobre uma delas para encaixar. Segure Ctrl ao soltar para não encaixar." Style="{StaticResource Hint}" Margin="0,6,0,0"/>

            <Border Style="{StaticResource Divider}"/>

            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconMonitor}" Style="{StaticResource SectionIcon}"/>
                <TextBlock Text="Monitor" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <TextBlock x:Name="MonitorName" Style="{StaticResource Label}" Margin="2,10,0,0"/>

            <Border Style="{StaticResource Divider}"/>

            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSplit}" Style="{StaticResource SectionIcon}"/>
                <TextBlock Text="Modo de divisão" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <WrapPanel x:Name="LayoutPanel" Margin="0,14,0,0"/>

            <StackPanel x:Name="CustomPanel" Margin="0,4,0,0">
                <Grid Margin="0,6,0,0">
                    <TextBlock Text="Colunas" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="−" Style="{StaticResource PillButton}" Width="38" Click="ColMinus_Click"/>
                        <TextBlock x:Name="ColText" Style="{StaticResource ValueText}" Width="34" TextAlignment="Center"/>
                        <Button Content="+" Style="{StaticResource PillButton}" Width="38" Click="ColPlus_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <TextBlock Text="Linhas" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="−" Style="{StaticResource PillButton}" Width="38" Click="RowMinus_Click"/>
                        <TextBlock x:Name="RowText" Style="{StaticResource ValueText}" Width="34" TextAlignment="Center"/>
                        <Button Content="+" Style="{StaticResource PillButton}" Width="38" Click="RowPlus_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Button Style="{StaticResource AccentButton}" Margin="0,18,0,0" Click="Arrange_Click" Content="Organizar janelas agora"/>
            <Button Style="{StaticResource PillButton}" Margin="0,8,0,0" Click="Preview_Click" Content="Mostrar zonas no monitor (3 s)"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
