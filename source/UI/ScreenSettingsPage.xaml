<UserControl x:Class="Ultragear.UI.ScreenSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
        <StackPanel Margin="40,10,24,20">
            <TextBlock Text="Ajustes da tela" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Configure o monitor para o seu ambiente de uso." Style="{StaticResource PageDesc}" Margin="0,6,0,18"/>

            <!-- connection banner -->
            <Border x:Name="Banner" CornerRadius="12" Background="#33FF7A8A" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="BannerText" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontSize="12.5"/>
                    <Button Content="Procurar novamente" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Height="32" Click="Retry_Click"/>
                </StackPanel>
            </Border>

            <!-- Monitor -->
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconMonitor}" Style="{StaticResource SectionIcon}"/>
                <TextBlock Text="Monitor" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <Grid Margin="0,12,0,0">
                <ComboBox x:Name="MonitorCombo" SelectionChanged="MonitorCombo_SelectionChanged" Margin="0,0,44,0"/>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTip="Ler novamente os valores do monitor" Click="Refresh_Click" Foreground="{StaticResource TextPrimary}">
                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Icon}" Width="18" Height="18"/>
                </Button>
            </Grid>
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="2,8,0,0"/>

            <Border Style="{StaticResource Divider}"/>

            <!-- Picture -->
            <Grid Background="Transparent" MouseLeftButtonDown="PictureHeader_Click" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPicture}" Style="{StaticResource SectionIcon}"/>
                    <TextBlock Text="Ajustes de imagem" Style="{StaticResource SectionTitle}"/>
                </StackPanel>
                <Path x:Name="PictureChevron" Data="{StaticResource IconChevronDown}" Style="{StaticResource Icon}" Stroke="{StaticResource Accent}" Width="16" Height="16" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform x:Name="ChevronRotate"/></Path.RenderTransform>
                </Path>
            </Grid>
            <StackPanel x:Name="PicturePanel" Margin="0,14,0,0">
                <WrapPanel x:Name="ModesPanel" HorizontalAlignment="Left"/>
                <Button x:Name="WizardButton" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="2,0,0,10" Click="Wizard_Click"
                        ToolTip="Ajusta o modo Imagem Personalizada escolhendo, passo a passo, a imagem que você prefere.">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconEdit}" Style="{StaticResource Icon}" Width="16" Height="16" Margin="0,0,8,0" Stroke="{StaticResource Accent}"/>
                        <TextBlock Text="Assistente de Imagem Personalizada"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="2,0,0,8"/>

                <StackPanel x:Name="SliderHost"/>

                <Grid Margin="0,12,0,0">
                    <TextBlock Text="Adaptive-Sync / VRR&#x0a;(FreeSync / G-SYNC Compatible)" Style="{StaticResource Label}" Margin="2,0,10,0" MaxWidth="190" HorizontalAlignment="Left"/>
                    <ComboBox x:Name="VrrCombo" HorizontalAlignment="Right" Width="170" SelectionChanged="Vrr_SelectionChanged">
                        <ComboBoxItem Content="Desligado"/>
                        <ComboBoxItem Content="Ligado"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <TextBlock Text="Temperatura de cor" Style="{StaticResource Label}" Margin="2,0,0,0"/>
                    <ComboBox x:Name="ColorTempCombo" HorizontalAlignment="Right" Width="200" SelectionChanged="ColorTemp_SelectionChanged"/>
                </Grid>
                <StackPanel x:Name="KelvinHost" Margin="0,6,0,0"/>
                <StackPanel x:Name="RgbHost"/>
            </StackPanel>

            <Border Style="{StaticResource Divider}"/>

            <!-- Sound -->
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSound}" Style="{StaticResource SectionIcon}"/>
                <TextBlock Text="Som (saída de fones)" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <StackPanel x:Name="SoundHost" Margin="0,8,0,0"/>
            <Grid Margin="0,6,0,0">
                <TextBlock Text="Sem som" Style="{StaticResource Label}" Margin="2,0,0,0"/>
                <CheckBox x:Name="MuteToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Click="Mute_Click"/>
            </Grid>

            <Border Style="{StaticResource Divider}"/>

            <!-- Energy -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconVivid}" Style="{StaticResource SectionIcon}"/>
                    <TextBlock Text="SMART ENERGY SAVING" Style="{StaticResource SectionTitle}"/>
                </StackPanel>
            </Grid>
            <ComboBox x:Name="EnergyCombo" HorizontalAlignment="Right" Width="200" Margin="0,12,0,0" SelectionChanged="Energy_SelectionChanged">
                <ComboBoxItem Content="Desligado"/>
                <ComboBoxItem Content="Baixo"/>
                <ComboBoxItem Content="Elevado"/>
            </ComboBox>
            <TextBlock Text="Economiza energia compensando a luminosidade; o brilho pode variar conforme o conteúdo." Style="{StaticResource Hint}" Margin="2,8,0,0"/>

            <Border Style="{StaticResource Divider}"/>

            <!-- Orientation -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRotate}" Style="{StaticResource SectionIcon}"/>
                    <TextBlock Text="Orientação da tela" Style="{StaticResource SectionTitle}"/>
                </StackPanel>
            </Grid>
            <ComboBox x:Name="OrientationCombo" HorizontalAlignment="Right" Width="200" Margin="0,12,0,0" SelectionChanged="Orientation_SelectionChanged"/>

            <Border Style="{StaticResource Divider}"/>

            <!-- My Display Preset -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPreset}" Style="{StaticResource SectionIcon}"/>
                    <TextBlock Text="Predefinição por aplicativo" Style="{StaticResource SectionTitle}"/>
                </StackPanel>
                <CheckBox x:Name="PresetToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" Click="PresetToggle_Click"/>
            </Grid>
            <TextBlock Text="O modo de imagem muda automaticamente conforme o aplicativo em primeiro plano." Style="{StaticResource Hint}" Margin="2,8,0,0"/>
            <Grid Margin="0,10,0,0">
                <TextBlock x:Name="PresetSummary" Style="{StaticResource Hint}" Margin="2,0,180,0" VerticalAlignment="Center"/>
                <Button Content="Editar" Style="{StaticResource PillButton}" HorizontalAlignment="Right" Width="170" Click="PresetEdit_Click"/>
            </Grid>

            <Border Style="{StaticResource Divider}"/>

            <!-- Profiles -->
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconProfile}" Style="{StaticResource SectionIcon}"/>
                <TextBlock Text="Meus perfis" Style="{StaticResource SectionTitle}"/>
            </StackPanel>
            <TextBlock Text="Salve o modo e os ajustes atuais e reaplique-os quando quiser." Style="{StaticResource Hint}" Margin="2,8,0,0"/>
            <ComboBox x:Name="ProfileCombo" Margin="0,10,0,0"/>
            <UniformGrid Columns="3" Margin="0,10,0,0">
                <Button Content="Aplicar" Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="ProfileApply_Click"/>
                <Button Content="Salvar atual" Style="{StaticResource PillButton}" Margin="3,0" Click="ProfileSave_Click"/>
                <Button Content="Excluir" Style="{StaticResource PillButton}" Margin="6,0,0,0" Click="ProfileDelete_Click"/>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
