<Window x:Class="Ultragear.UI.PresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Predefinição por aplicativo" Width="560" Height="620" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Border CornerRadius="22" Background="{StaticResource PanelBg}" BorderBrush="#4C5590" BorderThickness="1" Margin="10" MouseLeftButtonDown="Drag">
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
        <Grid Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Predefinição por aplicativo" Style="{StaticResource SectionTitle}" FontSize="18"/>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Cancel_Click">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="14" Height="14"/>
                </Button>
            </Grid>
            <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,8,0,14"
                       Text="O modo de imagem muda automaticamente quando o aplicativo mapeado fica em primeiro plano. Para os demais aplicativos, use a opção ao final."/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Rows"/>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PillButton}" Click="AddRunning_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" Width="14" Height="14" Margin="0,0,6,0" Stroke="{StaticResource Accent}"/>
                            <TextBlock Text="Aplicativo aberto"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PillButton}" Click="AddExe_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" Width="14" Height="14" Margin="0,0,6,0" Stroke="{StaticResource Accent}"/>
                            <TextBlock Text="Procurar .exe"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ComboBox x:Name="RunningCombo" Margin="0,10,0,0" Visibility="Collapsed" SelectionChanged="Running_SelectionChanged"/>
                <Grid Margin="0,16,0,0">
                    <TextBlock Text="Demais aplicativos" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="DefaultCombo" HorizontalAlignment="Right" Width="220"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Style="{StaticResource PillButton}" Width="120" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Aplicar" Style="{StaticResource AccentButton}" Width="120" Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
