<Window x:Class="Ultragear.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultragear" Width="452" Height="900" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="/Assets/ultragear.ico">
    <Grid Margin="14">
        <Border CornerRadius="28" Background="{StaticResource PanelBg}" BorderBrush="#3C4680" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55"/>
            </Border.Effect>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid x:Name="Header" Margin="26,18,18,0" Background="Transparent" MouseLeftButtonDown="Header_Drag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}" Margin="0,0,8,0">
                        <TextBlock Text="U" FontWeight="Black" FontSize="14" Foreground="#10202A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ULTRAGEAR" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" ToolTip="Minimizar para a bandeja" Click="Minimize_Click">
                        <Path Data="{StaticResource IconMinimize}" Style="{StaticResource Icon}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Fechar" Click="Close_Click">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- pages -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,4,0,0" Focusable="False"/>

            <!-- bottom navigation bar -->
            <Border Grid.Row="2" Margin="22,6,22,22" CornerRadius="24" Background="{StaticResource NavBg}" Padding="10,6">
                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4"/></Border.Effect>
                <UniformGrid Rows="1" HorizontalAlignment="Center">
                    <RadioButton x:Name="NavScreen" Style="{StaticResource NavButton}" Tag="{StaticResource IconScreenSettings}" ToolTip="Ajustes da tela" GroupName="nav" Checked="Nav_Checked" Margin="6,0"/>
                    <RadioButton x:Name="NavSplit" Style="{StaticResource NavButton}" Tag="{StaticResource IconSplit}" ToolTip="Divisão de tela" GroupName="nav" Checked="Nav_Checked" Margin="6,0"/>
                    <RadioButton x:Name="NavCalib" Style="{StaticResource NavButton}" Tag="{StaticResource IconCalibration}" ToolTip="Calibração e cor" GroupName="nav" Checked="Nav_Checked" Margin="6,0"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="{StaticResource IconSettings}" ToolTip="Configurações do Ultragear" GroupName="nav" Checked="Nav_Checked" Margin="6,0"/>
                </UniformGrid>
            </Border>

            <!-- toast -->
            <Border x:Name="ToastBox" Grid.Row="1" VerticalAlignment="Bottom" Margin="26,0,26,10" CornerRadius="12" Background="#E6141830"
                    Padding="14,10" Visibility="Collapsed" MouseLeftButtonDown="Toast_Click">
                <TextBlock x:Name="ToastText" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontSize="12.5"/>
            </Border>

            <!-- busy -->
            <Border x:Name="BusyBox" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" CornerRadius="14"
                    Background="#E6141830" Padding="14,7" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="14" Height="14" StrokeThickness="2.5" Stroke="{StaticResource Accent}" StrokeDashArray="4 2" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0">
                        <Ellipse.RenderTransform><RotateTransform x:Name="Spin"/></Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="BusyText" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
